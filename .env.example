# ============================================
# USERBOT1 · Environment Variables
# Copy to .env and fill values
# ============================================

# ===== REQUIRED =====
# https://my.telegram.org
API_ID=
API_HASH=

# @BotFather token (bot mode)
BOT_TOKEN=

# Your Telegram numeric user ID (@userinfobot)
OWNER_ID=

# ===== USERBOT =====
# python generate_session.py
STRING_SESSION=

# ===== DATABASE (optional) =====
MONGO_URI=
MONGO_DB=userbot1

# ===== RUNTIME =====
LOG_GROUP_ID=

BOT_NAME=Userbot1
OWNER_USERNAME=
SUPPORT_CHAT=
UPDATE_CHANNEL=

AUTO_DELETE=true
DELETE_DELAY=1
PREFIXES=.!

# ===== OPTIONAL =====
COOKIES_PATH=cookies.txt
BASE_URL=
API_KEY=
NUMLOOKUP_API_KEY=
