# ============================================
# YASHIKA PREMIUM · Environment Variables
# Copy this file to .env and fill the values
# ============================================

# ===== REQUIRED =====
# Get from https://my.telegram.org
API_ID=
API_HASH=

# BotFather token (required for bot mode)
BOT_TOKEN=

# Your Telegram numeric user ID (required)
# Get from @userinfobot or @getidsbot
OWNER_ID=

# ===== USERBOT (optional but recommended) =====
# Generate with: python generate_session.py
STRING_SESSION=

# ===== DATABASE (optional) =====
# MongoDB Atlas or Railway Mongo plugin
# Without this some features (warns, notes, economy) use memory-only
MONGO_URI=
MONGO_DB=yashika

# ===== RUNTIME =====
# Private log group ID (starts with -100...)
LOG_GROUP_ID=

BOT_NAME=Yashika
OWNER_USERNAME=
SUPPORT_CHAT=
UPDATE_CHANNEL=

# Auto-delete bot/userbot replies (true/false)
AUTO_DELETE=true
DELETE_DELAY=1.5

# Command prefixes (default . and !)
PREFIXES=.!

# ===== MUSIC / VC (optional) =====
# Path to YouTube cookies.txt for age-restricted / better quality
COOKIES_PATH=cookies.txt

# Optional external music API
BASE_URL=
API_KEY=

# Optional phone lookup API key for .nuinfo enhanced results
NUMLOOKUP_API_KEY=
